table DimBeds

	column BedID
		dataType: string
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: BedID

	column DepartmentID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: DepartmentID

	column BedType
		dataType: string
		summarizeBy: none
		sourceColumn: BedType

	column BedStatus
		dataType: string
		summarizeBy: none
		sourceColumn: BedStatus

	column IsStaffed
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: IsStaffed

	partition DimBeds = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimBeds.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"BedID", type text}, {"DepartmentID", type text}, {"BedType", type text}, {"BedStatus", type text}, {"IsStaffed", type logical}}, "en-US")
				in
				    Typed
