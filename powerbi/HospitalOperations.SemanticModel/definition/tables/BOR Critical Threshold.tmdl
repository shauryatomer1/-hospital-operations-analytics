table 'BOR Critical Threshold'

	column 'BOR Critical Threshold'
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: [BOR Critical Threshold]

	partition 'BOR Critical Threshold' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 0.5, 1, 0.01 ), "BOR Critical Threshold", [Value] )
